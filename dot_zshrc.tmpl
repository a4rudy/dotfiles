
if [ -f "$HOME/.local/bin/env" ]; then
  . "$HOME/.local/bin/env"
fi
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac
case ":$PATH:" in
  *":$HOME/.bun/bin:"*) ;;
  *) export PATH="$HOME/.bun/bin:$PATH" ;;
esac

if [[ "$OSTYPE" == darwin* ]]; then
  limactl() {
    if [[ "$1" == shell && "$*" != *"--workdir"* ]]; then
      command limactl shell --workdir /home/dev "${@:2}"
    else
      command limactl "$@"
    fi
  }
fi

cs() {
  cd "$@" && ls
}

if [[ "$OSTYPE" == darwin* ]]; then
  lima_remove() {
    if (( $# != 1 )); then
      print -u2 "Usage: lima_remove INSTANCE"
      return 2
    fi

    local instance="$1"
    local machines machine_id

    machines="$(herdr machine list --json)" || return
    machine_id="$(print -r -- "$machines" | command jq -r --arg instance "$instance" '.[] | select(.label == $instance or .target == ("lima-" + $instance)) | .id' | head -n 1)" || return

    limactl stop "$instance" || return
    limactl remove "$instance" || return

    if [[ -n "$machine_id" ]]; then
      herdr machine remove "$machine_id" || return
    fi
  }
fi

if [ -x "$HOME/.local/bin/fzf" ]; then
  source <("$HOME/.local/bin/fzf" --zsh)
fi

if [ -f "$HOME/.zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh" ]; then
  source "$HOME/.zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

if [ -x "$HOME/.local/bin/starship" ]; then
  eval "$("$HOME/.local/bin/starship" init zsh)"
fi

if [ -f "$HOME/.zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]; then
  source "$HOME/.zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi
